# VulnScope 配置文件示例
# 复制为 config.yaml 后根据实际环境修改

# 运行模式: server / worker / all
mode: all

# HTTP API 服务配置
server:
  addr: ":8088"

# 数据库配置
database:
  driver: mysql
  dsn: "scanner:scanner123@tcp(127.0.0.1:3306)/scanner?charset=utf8mb4&parseTime=True&loc=Local"

# Redis 配置 (Asynq 任务队列)
redis:
  addr: "127.0.0.1:6379"
  password: ""
  db: 0

# Worker 配置
worker:
  concurrency: 10
  scanner_concurrency:
    domain: 5
    alive: 10
    port: 5
    finger: 5
    vuln: 3
  max_retry: 3
  retry_delay_sec: 60

# 扫描器配置
scanner:
  nmap_path: nmap
  nuclei_path: nuclei
  nuclei_templates: ""
  alive_timeout: 60
  finger_timeout: 1200
  vuln_timeout: 1200
